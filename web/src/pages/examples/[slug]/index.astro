---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChoicePanel from '../../../components/ChoicePanel';
import { examples, type Example } from '../../../data/examples';
import { pathTo } from '../../../utils/paths';

export function getStaticPaths() {
  return examples.map((example) => ({ params: { slug: example.slug }, props: { example } }));
}

const { example } = Astro.props as { example: Example };
---
<BaseLayout title={example.title} section="break" description={example.description}>
  <div class="wrap example-layout">
    <div class="example-main">
      <a class="back-link" href={pathTo('break/')}>← Všechny ukázky</a>
      <div class="example-meta"><span>{example.category}</span><span>{example.duration}</span><span>{example.portraits ? 'Skutečné a vytvořené snímky' : example.video ? 'Video k posouzení' : 'Fiktivní situace'}</span></div>
      <h1>{example.title}{!example.title.endsWith('?') && <span class="title-dot">.</span>}</h1>
      {example.preview && <p class="preview-label">OCHUTNÁVKA TÉMATU PO PŘESTÁVCE</p>}
      <section class="situation" aria-labelledby="situation-title"><div class="step-label">01 / SITUACE</div><h2 id="situation-title">Představte si…</h2><p>{example.situation}</p></section>
      <section class="choice-section" aria-labelledby="choice-title"><div class="step-label">02 / VAŠE VOLBA</div><h2 id="choice-title">Jak byste se rozhodli?</h2><ChoicePanel question={example.question} options={example.options} correctOption={example.correctOption} assessment={example.assessment} multiple={example.multiple} prompt={example.prompt} email={example.email} activity={example.activity} portraits={example.portraits} video={example.video} revealExplanation={{ explanation: example.explanation, action: example.action }} client:load /></section>
      {example.slug === 'urgent-phone-call' && <p class="incident-link">Došlo už k platbě nebo předání bankovních údajů? <a href={pathTo('incident/')}>Podívejte se na postup při incidentu ↗</a></p>}
      {example.slug === 'data-already-shared' && <p class="incident-link"><a href={pathTo('incident/')}>Další kroky při incidentu ↗</a></p>}
      <section class="example-sources" aria-labelledby="sources-title"><div class="step-label">ZDROJE</div><h2 id="sources-title">Kam dál</h2>{example.portraits || example.video ? <details><summary>{example.video ? 'Zdroje a původ videa' : 'Zdroje a licence snímků'}</summary>{example.sources.map((source) => <p><a href={source.url}>{source.organization}: {source.name} ↗</a><br /><small>{source.detail}</small>{source.licenseUrl && <> <a href={source.licenseUrl}>Licence CC BY-SA 4.0 ↗</a></>}</p>)}</details> : example.sources.map((source) => <p><a href={source.url}>{source.organization}: {source.name} ↗</a><br /><small>{source.detail}</small>{source.licenseUrl && <> <a href={source.licenseUrl}>Licence CC BY-SA 4.0 ↗</a></>}</p>)}</section>
      <a class="text-link" href={pathTo('break/')}>← Zpět na všechny ukázky</a>
    </div>
    <aside class="example-aside"><span>UKÁZKA</span><strong>{example.number}<span>.</span></strong><p>Krátká situace pro vlastní zamyšlení.</p></aside>
  </div>
</BaseLayout>