---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExampleCard from '../../components/ExampleCard.astro';
import { examples } from '../../data/examples';
import { pathTo } from '../../utils/paths';
---
<BaseLayout title="Ukázky" section="break" description="Krátké dobrovolné ukázky o soukromí, ověřování informací, podvodech a AI v práci.">
  <section class="wrap page-intro"><div class="eyebrow"><span class="dot"></span> PŘESTÁVKOVÝ ROZCESTNÍK</div><h1>Malá zastavení.<br /><em>Velké otázky.</em></h1><div class="page-intro-bottom"><p>Vyberte si situaci, která vás zajímá. Každá ukázka je dobrovolná a můžete se k ní vrátit i po přednášce.</p><span class="page-note">BEZ PŘIHLÁŠENÍ<br />BEZ ČASOVÉHO LIMITU</span></div><div class="quiz-entry"><div><span class="eyebrow">VYZKOUŠEJTE SI VÍCE SITUACÍ</span><p>Sedm nových situací k praktickému rozhodování, s výsledkem na konci.</p></div><a class="button primary" href={pathTo('quiz/')}>Spustit test <span aria-hidden="true">→</span></a></div></section>
  <section class="wrap section-space section-tight"><div class="section-rule"><h2>Vyberte si téma</h2><span>01 — {String(examples.length).padStart(2, '0')}</span></div><div class="example-grid">{examples.map((example) => <ExampleCard example={example} />)}</div></section>
  <section class="wrap support-callout"><div><span class="eyebrow">PRAKTICKÝ POSTUP</span><h2>Nejdřív se zastavit.<br /><em>Pak ověřit.</em></h2></div><div><p>Pokud už došlo k podezřelé platbě nebo sdílení údajů, podívejte se na první kroky.</p><a class="text-link" href={pathTo('incident/')}>Co dělat při incidentu <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>