---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExampleCard from '../components/ExampleCard.astro';
import { listedExamples as examples } from '../data/examples';
import { pathTo } from '../utils/paths';
---
<BaseLayout title="Přednáška" section="home" description="Pozvánka na přednášku Věříte AI? Možná byste neměli, 5. 11. 2026 od 18:00 v COMO Coworking Most, a krátké ukázky k vyzkoušení.">
  <section class="intro wrap">
    <div class="intro-kicker"><span class="dot"></span> PŘEDNÁŠKA PRO KAŽDODENNÍ ŽIVOT I PRÁCI</div>
    <h1>Bezpečnost AI<span class="title-dot">.</span></h1>
    <p class="intro-lead">Umělá inteligence otevírá nové možnosti. Pojďme se společně podívat, jak ji používat s rozmyslem.</p>
    <dl class="event-facts"><div><dt>Kdy</dt><dd><time datetime="2026-11-05T18:00+01:00">čtvrtek 5. 11. 2026 od 18:00</time></dd></div><div><dt>Kde</dt><dd>COMO Coworking Most, pasáž U Lva</dd></div><div><dt>Vstupné</dt><dd>129 Kč</dd></div></dl>
    <p class="event-note">Přednáška „Věříte AI? Možná byste neměli“ je součástí cyklu MOSThub v rámci Dnů AI 2026 a koná se ve spolupráci s COMO Coworking Most. Po skončení následuje networking s drobným občerstvením. <a class="text-link" href="https://dny.ai/program/verite-ai-mozna-byste-nemeli">Oficiální pozvánka ↗</a> <a class="text-link" href="https://goout.net/cs/verite-ai-mozna-byste-nemeli/szqksny/">Přihlášení na GoOut ↗</a></p>
    <div class="intro-bottom"><a class="button primary" href={pathTo('break/')}>Prohlédnout ukázky <span aria-hidden="true">↗</span></a><a class="button secondary" href={pathTo('quiz/')}>Spustit test <span aria-hidden="true">↗</span></a><span class="intro-note">Pro veřejnost i podnikatele<br />Bez technických předpokladů</span></div>
    <div class="intro-index" aria-hidden="true">AI <span>/</span> 01</div>
  </section>
  <section class="topic-band">
    <div class="wrap topic-inner"><p>O ČEM BUDE ŘEČ</p><div><span>Soukromí a data</span><span>Ověřování informací</span><span>Podvody</span><span>AI v práci</span></div></div>
  </section>
  <section class="wrap section-space" aria-labelledby="intro-examples">
    <div class="section-heading"><div><div class="eyebrow"><span class="dot"></span> KRÁTKÉ UKÁZKY</div><h2 id="intro-examples">Zkuste si to <em>po svém.</em></h2></div><div class="heading-aside"><p>Jedna situace, několik možností a praktická myšlenka, kterou si můžete odnést.</p><a class="text-link" href={pathTo('break/')}>Všechny ukázky <span aria-hidden="true">↗</span></a></div></div>
    <div class="example-grid">{examples.slice(0, 3).map((example) => <ExampleCard example={example} />)}</div>
  </section>
  <section class="help-band"><div class="wrap help-inner"><div><div class="eyebrow">KDYŽ SI NEJSTE JISTÍ</div><h2>Stalo se něco<br /><em>podezřelého?</em></h2></div><div><p>První kroky při podezřelé platbě, ohrožení účtu nebo sdílení pracovních dat.</p><a class="button dark" href={pathTo('incident/')}>Přejít na postup <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>