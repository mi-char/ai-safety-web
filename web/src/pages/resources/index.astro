---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sources, type Source } from '../../data/examples';
const resourceList: Source[] = Object.values(sources);
---
<BaseLayout title="Zdroje a soukromí" section="resources" description="Zdroje k ukázkám a informace o tom, jak web zachází s vašimi volbami.">
  <div class="wrap article-layout"><div class="eyebrow"><span class="dot"></span> ZDROJE A SOUKROMÍ</div><h1>Pro další<br /><em>přemýšlení.</em></h1><p class="article-lead">Odkazy k ukázkám a informace o tom, jak web zachází s vašimi volbami.</p>
    <p class="source-note">Odkazy na sociální sítě a další platformy třetích stran se otevřou až po kliknutí; jejich obsah se může změnit nebo zmizet.</p>
    <section class="resources-list" aria-labelledby="resources-title"><div class="step-label">ZDROJE</div><h2 id="resources-title">Původní zdroje</h2>{resourceList.map((source) => <article><span>{source.organization}</span><h3><a href={source.url}>{source.name} ↗</a></h3><p>{source.detail}{source.licenseUrl && <> <a href={source.licenseUrl}>Licence CC BY-SA 4.0 ↗</a></>}</p></article>)}</section>
    <section class="privacy-section" aria-labelledby="privacy-title"><div class="step-label">SOUKROMÍ</div><h2 id="privacy-title">Co se děje s volbami?</h2><p>Provozovatel webu: mi-char. Web je hostován na GitHub Pages.</p><p>Odpovědi v ukázkách zůstávají pouze v paměti otevřené stránky. Web je neukládá ani neodesílá a po obnovení se výběr vymaže.</p><p>GitHub může při načtení stránky zpracovávat provozní údaje, například IP adresu a čas požadavku. Podrobnosti uvádí <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement">zásady ochrany soukromí GitHubu ↗</a>. Externí zdroje a registrace se otevřou až po kliknutí a řídí se vlastními pravidly.</p></section>
  </div>
</BaseLayout>